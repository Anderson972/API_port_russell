             Documentation API
        </a>
    </div>
</header>
<main>
    <div class="presentation mx-auto" style="width: 800px;">
        <h2>Bienvenu sur l'API du port de plaisance de Russell</h2>
        <p class="text-center">Cette application pertmet la gestion de reservation des catway.</p>
    </div>
    <form id="form_log" method="post" action="http://localhost:3000/login" class="card mx-auto" style="width: 500px;">
        <fieldset>  
            <legend class="m-3">Se connecter</legend>
            <div class="form-floating m-3">
                <input type="text" name="email" id="mail_log" placeholder="name@mail.com" class="form-control <%= locals.isInvalid ? 'is-invalid' : '' %>" value="<%= mail%>">
                <label for="email">Mail</label>
            </div>
            <div class="input-group">
                <div class="form-floating flex-grow-1">
                    <input id="password_log" type="password" name="password" class="form-control <%= locals.isInvalid ? 'is-invalid' : '' %>" placeholder="" required>
                    <label for="password">Mot de passe</label>
                </div>
                <button class="btn btn-outline-secondary" type="button" id="btnHide2" onclick="hidePassword('password_log','btnHide2')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                    <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                    <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/>
                    </svg>
                </button>
            </div>
            <button type="submit" class="btn btn-primary m-3">Connexion</button>
        </fieldset>

    </form>
    <div class="alert alert-danger ms-auto <%= locals.isInvalid? 'is-invalid' : '' %>" role="alert">
    Identifant incorrecte
    </div>

<%- include('footer.ejs') -%>