<%- include('header.ejs') -%>
<%- include('navbar.ejs') %>
<h1>Catways</h1>
<div class="d-flex justify-content-center align-items-center gap-2 mb-3">
    
    <!-- <form action="/catways" method="get" class="d-flex align-items-center gap-2">
        <label for="id">N° de catway</label>
        <input type="number" name="id" placeholder="1,2,..." min="1" required class="form-control" style="width: 100px;">
        <button type="submit" class="btn btn-primary">
            Afficher les catways
        </button>
    </form> -->
    <span class="d-inline-block" tabindex="0" data-bs-toggle="tooltip" data-bs-title="Afficher les réservations avant de créer">
        <button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#collapseCreate" <%= !catway_num ? 'disabled ' : '' %>>
            Créer un catway
        </button>
    </span>
</div>
<Div class="row">
    <div class="list_catways col-6">
        <div class="mt-3 alert alert-danger <%= err_msg ? 'voir' : '' %>" role="alert">
                <%= err_notFind %>
        </div>
        
            <table class="table text-center align-middle">
                <thead>
                    <tr>
                        <th>N° de catway</th>
                        <th>Type</th>
                        <th>Etats</th>
                        <th></th>
                    </tr>
                </thead>
                <% catways.forEach(catway => { %>
                    <tbody class="table-hover-group">
                        <tr>
                            <td><%= catway.catwayNumber %></td>
                            <td><%= catway.catwayType %></td>
                            <td><%= catway.catwayState %></td>
                            <td>
                                <a href="/catways/<%= catway.catwayNumber %>" class="btn btn-primary">Modifier</a>

                                <!-- Modal confirmation -->
                                <button type="button" class="btn btn-outline-danger mt-3 d-block" data-bs-toggle="modal" data-bs-target="#deleteConfirmation-<%= catway.catwayNumber %>">Supprimer</button>
                                <div class="modal fade" id="deleteConfirmation-<%= catway.catwayNumber %>" tabindex="-1" >
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5" >Confirmation</h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Etes-vous sure de vouloir supprimer cette réservation ?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non</button>
                                                <button type="submit" class="btn btn-outline-danger" onclick="deleteCat(`/catways/<%= catway.catwayNumber %>`)">Supprimer</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Fin Modal confirmation -->
                            </td>
                        </tr>
                    </tbody>
                <% }) %>
            </table>
    </div>
    <div class="create_reservations col-6">
        <div class="collapse" id="collapseCreate">
            <form class="form-group mt-3" action="/catways" method="post">
                <fieldset>
                    <div class="form-floating mb-3">
                        <input type="number" name="catwayNumber" class="form-control" min="1" placeholder="">
                        <label for="catwayNumber">N° de catway</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select class="form-select" name="catwayType" required>
                            <option selected>Selectionner un type</option>
                            <option value="short">short</option>
                            <option value="long">long</option>
                        </select>
                        <label for="catwayType">Type de catway</label>
                    </div>
                    <div class="form-floating mb-3">
                        <textarea type="textaera" name="catwayState" class="form-control" placeholder="" required>
                        <label for="catwayState">Nom du bateau</label>
                        <small><em>Maximun 500 caractères</em></small>
                    </div>   
                </fieldset>
                <button type="submit" class="btn btn-primary mt-3 float-end" >Créer la réservation</button>
            </form>
        </div>
        <div id="succ_msg" class="mt-3 alert alert-success <%= locals.succ_msg ? 'd-block' : 'd-none' %>" role="alert">
            Votre réservation a été Créée
        </div>
        <div id="err_create" class="mt-3 alert alert-danger <%= locals.err_create ? 'd-block' : 'd-none' %>" role="alert">
            Une erreur s'est produite lors de la création de votre catway
        </div>
    </div>
</Div>

<%- include('footer.ejs') -%>