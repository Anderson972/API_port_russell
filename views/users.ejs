<%- include('header.ejs') -%>
<%- include('navbar.ejs') %>
<h1><%= title %></h1>
<Div class="row justify-content-center gx-0">
    <div class="list col-6 p-2">
        <div class="mt-3 alert alert-danger <%= err_msg ? 'voir' : '' %>" role="alert">
                <%= err_notFind %>
        </div>
            <table class="shadow table text-center align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th></th>
                    </tr>
                </thead>
                <% users.forEach(user => { %>
                    <tbody class="table-hover-group">
                        <tr>
                            <td><%= user.username %></td>
                            <td><%= user.email %></td>
                            <td>
                                <a href="/users/<%= user.email %>" class="btn btn-primary">Modifier</a>

                                <!-- Modal confirmation -->
                                <button type="button" class="btn btn-outline-danger mt-3 d-block" data-bs-toggle="modal" data-bs-target="#deleteConfirmation-<%= user.username %>">Supprimer</button>
                                <div class="modal fade" id="deleteConfirmation-<%= user.username %>" tabindex="-1" >
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5" >Confirmation</h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Etes-vous sure de vouloir supprimer cet utilisateur ?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Non</button>
                                                <button type="submit" class="btn btn-outline-danger" onclick="deleteOne(`/users/<%= user.email %>`)">Supprimer</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Fin Modal confirmation -->
                            </td>
                        </tr>
                    </tbody>
                <% }) %>
            </table>
    </div>
    <div class="vr"></div>
    <div class="create d-flex justify-content-center align-items-center col-6">
        <button id="create_btn" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#collapseCreate">
            Créer un utilisateur
        </button>
        <div class="collapse" id="collapseCreate">
            <h3 class="text-center">Créer votre utilisateur</h3>
            <form id="form_create" class="shadow form-group mt-3" action="/users" method="post">
                <fieldset>
                    <div class="form-floating mb-3">
                        <input type="text" name="username" class="form-control" placeholder="" required>
                        <label for="username">Username</label>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="email" class="form-control" name="email" placeholder="" required >
                        <label for="email">Email</label>
                    </div>
                    <div class="input-group mb-3">
                        <div class="form-floating">
                            <input id="password" type="password" name="password" class="form-control" placeholder="" required>
                            <label for="password">Mot de passe</label>
                        </div>
                        <button class="btn btn-outline-secondary" type="button" id="btnHide" onclick="hidePassword('password','btnHide')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                            <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                            <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/>
                            </svg>
                        </button>
                    </div>
                    <div class="input-group">
                        <div class="form-floating">
                            <input id="passwordConfirmed" type="password" name="passwordConfirmed" class="form-control" placeholder="" required>
                            <label for="passwordConfirmed">Confirmez le mot de passe</label>
                        </div>
                        <button class="btn btn-outline-secondary" type="button" id="btnHide2" onclick="hidePassword('passwordConfirmed','btnHide2')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                            <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7 7 0 0 0 2.79-.588M5.21 3.088A7 7 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474z"/>
                            <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12z"/>
                            </svg>
                        </button>
                    </div>
                    <small id="notSame" class="" hidden>le mot de passe n'est pas identique !</small>
                    <div id="war_msg" class="mt-3 alert alert-warning" role="alert">
                        <small>
                            Le mot de passe doit contenir au moins :
                        </small>
                        <ul>
                            <li><small>Une majuscule</small></li>
                            <li><small>Une minuscule</small></li>
                            <li><small>Un chiffre</small></li>
                            <li><small>Un caractère spécial</small></li>
                        </ul>
                    </div>
                </fieldset>
                <button type="submit" class="btn btn-primary mt-3 float-end" >Créer l'utilisateur</button>
            </form>
        </div>
        <div id="succ_msg" class="mt-3 alert alert-success position-absolute bottom-50 <%= locals.succ_msg ? 'd-block' : 'd-none' %>" role="alert">
            Votre utilisateur a été Créé
        </div>
        <div id="err_create" class="mt-3 alert alert-danger <%= locals.err_create ? 'd-block' : 'd-none' %>" role="alert">
            Une erreur s'est produite lors de la création de votre utilisateur
        </div>
    </div>
</Div>

<%- include('footer.ejs') -%>